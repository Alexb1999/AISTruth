# Copy to `.env` in this directory (`apps/api`) and fill in secrets. Never commit `.env`.
# Run the API from `apps/api` so pydantic loads `.env` (see README).

# --- BarentsWatch (Norway AIS) — required for /v1/ais/norway/* and /v1/validate/* ---
# Register at https://www.barentswatch.no/ → MyPage → create API client with OAuth2
# client credentials and scope exactly: ais
# Client ID is often email:ClientName from My clients — use quotes if it contains spaces, e.g.:
# BARENTSWATCH_CLIENT_ID="you@example.com:AISTruth API"
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=

# --- Optional: PostGIS for nearest-node on validate ---
# DATABASE_URL=postgresql://aistruth:aistruth@localhost:5432/aistruth

# --- Optional: CORS (defaults include localhost:3000) ---
# AISTRUTH_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Optional: GEODNET NTRIP (see docs/integrations/geodnet-rtk.md) ---
# GEODNET_NTRIP_USER=
# GEODNET_NTRIP_PASSWORD=
# AISTRUTH_ENABLE_GEODNET_DEBUG=true
