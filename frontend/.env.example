# Copy to `.env.local` in this directory (`frontend`). Never commit `.env.local`.
#
# Server-side URL for the Next.js /api/leads proxy (not exposed to the browser).
export API_URL="http://127.0.0.1:8000"

# Must match AISTRUTH_LEADS_KEY on the API when AISTRUTH_LEADS_ENABLED=true.
export LEADS_SUBMIT_KEY="generate-a-long-random-secret"

# Optional: browser-visible API URL for the demo console only.
export NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
