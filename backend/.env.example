# Copy to `.env` in this directory (`backend`) and fill in secrets. Never commit `.env`.
#
# The FastAPI app loads this file automatically via pydantic-settings when run from
# `backend`. Shell commands (`curl`, `scripts/ntrip_smoke.py`) need exported variables:
#
#   set -a; source backend/.env; set +a
#
# Use raw values here. Do not URL-encode `@`, `:`, spaces, or secrets; HTTP clients encode
# form fields when needed.

# BarentsWatch (Norway AIS) — required for /v1/ais/norway/* and /v1/validate/*
export BARENTSWATCH_CLIENT_ID="you@example.com:AISTruth API"
export BARENTSWATCH_CLIENT_SECRET="replace-with-your-client-password"

# Optional: PostGIS for nearest-node lookup and persistence.
export DATABASE_URL="postgresql://aistruth:aistruth@localhost:5432/aistruth"

# Optional: CORS for the Next.js dev UI.
export AISTRUTH_CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"

# Optional for local dev, required before exposing /v1 routes outside localhost.
# Comma-separated. Empty disables API-key auth. DB-issued tenant keys take precedence.
export AISTRUTH_API_KEYS=""

# Operator routes (GET /v1/admin/usage). Never commit a real value.
export AISTRUTH_ADMIN_KEY=""

# Optional: JSONL replay path when AISTRUTH_AIS_SOURCE=file.
export FILE_REPLAY_PATH=""

# Optional: seconds to cache BarentsWatch historic tracks in process. Use 0 to disable.
export AISTRUTH_TRACK_CACHE_TTL="30"

# Optional: seconds to cache BarentsWatch vessel picker (GET /latest/combined). Default 300.
export AISTRUTH_VESSEL_LIST_CACHE_TTL="300"

# Keep false on any shared deployment — requires X-AIS-Key before server-side BarentsWatch calls.
export AISTRUTH_BARENTSWATCH_ALLOW_ANONYMOUS="false"

# Optional: AIS source selector for future adapters.
export AISTRUTH_AIS_SOURCE="barentswatch"
export SPIRE_API_KEY=""
export SPIRE_BASE_URL="https://api.spire.com"

# Optional: GEODNET NTRIP rover credentials (trial or subscription). Not used for station list.
export GEODNET_NTRIP_USER=""
export GEODNET_NTRIP_PASSWORD=""
export GEODNET_NTRIP_HOST="rtk.geodnet.com"
export GEODNET_NTRIP_PORT="2101"
export GEODNET_NTRIP_MOUNT="AUTO"
export GEODNET_SMOKE_LAT="59.6667"
export GEODNET_SMOKE_LON="10.6333"
export AISTRUTH_ENABLE_GEODNET_DEBUG="false"

# Optional: GEODNET RTK REST API (enterprise appId/appKey) for live station catalog sync.
# See https://github.com/geodnet/GEODNET_API/blob/main/GEODNET_RTK_API.md
export GEODNET_RTK_APP_ID=""
export GEODNET_RTK_APP_KEY=""
export GEODNET_RTK_API_BASE="https://rtk.geodnet.com"
# Optional ISO 3166-1 alpha-3 filter for POST /api/v3/station/list (e.g. NOR, USA).
export GEODNET_RTK_STATION_REGION=""
# If true, call station sync once when the API process starts (requires DATABASE_URL).
export GEODNET_SYNC_STATIONS_AT_STARTUP="false"

# Pilot contact form (POST /v1/leads). Disabled by default — enable only on your deployment.
export AISTRUTH_LEADS_ENABLED="false"
# Required when leads are enabled on a public host. Match LEADS_SUBMIT_KEY in frontend/.env.local.
export AISTRUTH_LEADS_KEY=""
